# Neon Postgres connection string (from Neon dashboard, use the pooled connection)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js - generate with: openssl rand -base64 32
AUTH_SECRET=""

# The app's own address. APP_URL is what every link that leaves the app is
# built from - emails, QR labels on physical equipment, sitemap, share links -
# and AUTH_URL is what Auth.js derives the session cookie's __Secure- prefix
# from. They must agree: a mismatch does not error, it just fails to sign
# anyone in.
#
# Choose it once. The QR label on an instrument encodes APP_URL/instruments/42
# in ink, so this outlives any later change of mind about hostnames.
APP_URL="https://ridgelinefield.com"
AUTH_URL="https://ridgelinefield.com"

# Resend API key for magic-link sign-in emails (free tier is fine: resend.com)
AUTH_RESEND_KEY=""
# The from address, must be on a domain you verified in Resend (or use
# onboarding@resend.dev to test).
#
# BOTH addresses below sit on mail.ridgelinefield.com because that is the ONE
# domain verified in Resend - verifying the apex is a separate act, and a from
# address on an unverified domain does not bounce, it simply never sends.
#
# Pick these once. lib/emailThread invents the digest's Message-IDs from the
# sending domain, so changing it later starts every client's digest thread over.
EMAIL_FROM="Ridgeline <notifications@mail.ridgelinefield.com>"
# The sender for DAILY REPORTS - the digest and the EOD report both - so that
# a morning report and a sign-in link are not the same kind of mail.
#
# The real argument is reputation: a client who marks a report as spam must
# never cost somebody else the ability to sign in. Separate addresses keep
# those two fates apart. Must be on a domain verified in Resend - a SUBDOMAIN
# is verified in its own right, which is the point of using one.
#
# Unset = use EMAIL_FROM, which is how instances behaved before this existed.
DIGEST_EMAIL_FROM="Ridgeline <updates@mail.ridgelinefield.com>"
# Where replies to a broadcast go - the daily digest and the EOD report both.
#
# Not optional in practice, and here is why. Both of those go to a whole client
# team ON ONE MESSAGE, deliberately, so that reply-all reaches everybody. But
# they are sent FROM mail.ridgelinefield.com, which exists to send: the only MX
# on it is Resend's bounce collector, and nothing delivers a human's reply
# there. Leave this blank and the first reply-all bounces for every recipient
# at once.
#
# So point it at a real mailbox on the APEX, which is where MX for people
# lives. Sending subdomain sends; apex receives. DIGEST_REPLY_TO is the older
# name and still works.
REPLY_TO="updates@ridgelinefield.com"

# Comma-separated staff emails. These accounts get the 'staff' role on first sign-in.
# The first email in the list gets 'owner'.
STAFF_EMAILS="joe@example.com,bill@example.com"

# Comma-separated client emails (Lab Zen). Only allowed in when client access is toggled on.
CLIENT_EMAILS=""

# Vercel Blob read-write token (auto-populated when you add Blob storage to the project)
BLOB_READ_WRITE_TOKEN=""

# --- Google Sheet parity (service account - preferred) ---
# 1. console.cloud.google.com > new project > enable "Google Sheets API"
# 2. IAM & Admin > Service Accounts > create one (no roles needed) > Keys > add JSON key
# 3. Share the client's sheet with the service account email (Viewer)
# From the downloaded JSON: client_email and private_key.
GOOGLE_SERVICE_ACCOUNT_EMAIL="sheet-reader@your-project.iam.gserviceaccount.com"
# Paste the private_key value as-is (Vercel keeps the \n escapes; the app restores them)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# The sheet ID from its URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=""
# Optional: tab + columns to read (default shown)
SHEET_RANGE="'Refurbishment Tracker'!A:H"

# Fallback: published-CSV URL (only used if the service account vars are unset)
SHEET_CSV_URL=""

# Random secret the cron endpoint requires (Vercel sets Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# --- Maps (optional) ---
# Geocoding (an address becomes a point) and routing (road miles between two
# points) power the per-engineer trip miles on a work order. UNSET, the open
# stack answers: OpenStreetMap's Nominatim geocodes and the public OSRM server
# routes - free, no key, fine at this app's volume (once per saved address,
# once per engineer-site pair, remembered in drive_cache). Set a Google Maps
# key to use Google for both instead - paid, and carrying an SLA the public
# servers do not promise. Either way a provider outage costs nothing but
# freshness: pages never wait on a maps API, and the strip falls back to the
# site's typed miles.
GOOGLE_MAPS_API_KEY=""
# Browser-side key for address autocomplete (Places API New). SEPARATE from the
# server key on purpose: this one ships to every browser, so it must be locked
# to your domains (HTTP referrer restriction) and to the Places API alone,
# where the server key stays secret and IP/API-restricted. Same Google Cloud
# project, two keys, two blast radii. Unset = address fields are plain inputs.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# --- Payments: Stripe Connect (Express) ---
# TEST MODE ONLY until launch. The key itself decides the mode - sk_test_ or
# sk_live_ - and every money surface reports which one is configured, because
# the failure everybody has seen is a test key quietly left in production, or
# worse, the reverse.
#
# Leave these blank and nothing breaks: the pay buttons simply do not render
# and the client portal explains how to send a check instead.
#
# The connected account belongs to the SERVICE COMPANY, not to this platform.
# Stripe runs the identity checks on them, money moves bank to bank, and
# Ridgeline never holds funds and never sees a card number.
#
# 1. dashboard.stripe.com > Developers > API keys > copy the TEST secret key
# 2. Connect > Settings > enable Express accounts
# 3. Developers > Webhooks > add an endpoint at
#    https://ridgelinefield.com/api/stripe/webhook listening for
#    checkout.session.completed, then copy its signing secret
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
